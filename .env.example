RUNPROOF_SECRET_KEY=change-this-to-a-long-random-value
RUNPROOF_DEMO_MODE=1
RUNPROOF_PORT=8000
RUNPROOF_HOST=0.0.0.0

# safe = never execute uploaded code. Built-in demos can still run their controlled build.py.
# trusted = also execute build.py from projects YOU trust. Never use trusted for unknown uploads.
RUNPROOF_EXECUTION_MODE=safe

# Real SMS OTP with Twilio Verify (fill these for real phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=


# When demo mode is 0, signup is blocked unless real SMS OTP is configured.
# Fill all three Twilio Verify values below for real phone SMS OTP.
