# RunProof server
RUNPROOF_HOST=127.0.0.1
RUNPROOF_PORT=8000
RUNPROOF_DEBUG=1

# Change this in production. A random dev secret is generated if blank.
RUNPROOF_SECRET_KEY=

# static | trusted
# static = never executes uploaded project code
# trusted = local subprocess execution for projects YOU TRUST (hackathon demo only)
RUNPROOF_EXECUTION_MODE=static
RUNPROOF_EXEC_TIMEOUT=60

# console = prints OTP in server console for local demo
RUNPROOF_OTP_MODE=console
RUNPROOF_DEV_SHOW_OTP=1
RUNPROOF_OTP_TTL_SECONDS=300
RUNPROOF_SESSION_TTL_SECONDS=604800

# Upload limits
RUNPROOF_MAX_UPLOAD_MB=50
RUNPROOF_MAX_UNCOMPRESSED_MB=250
RUNPROOF_MAX_FILES=5000
